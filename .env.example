DISCORD_TOKEN=
NYVEXA_GUILD_ID=
NYVEXA_FC_ID=
NYVEXA_MEMBER_ROLE_ID=
NYVEXA_UNVERIFIED_ROLE_ID=

# Optional. One of: na, eu, jp, fr, de
NYVEXA_LODESTONE_REGION=na

# Optional custom FC-rank -> Discord-role mapping.
# The bot role must be above every role it manages.
NYVEXA_RANK_ROLES={"Master":"123456789012345678","Officer":"234567890123456789"}

# Optional. Defaults shown.
NYVEXA_DATABASE_URL=sqlite://nyvexa.db?mode=rwc
NYVEXA_SYNC_INTERVAL_SECS=900
NYVEXA_MEMBERSHIP_GRACE_SECS=43200
NYVEXA_CHALLENGE_TTL_SECS=1800
RUST_LOG=nyvexa=info
